    </geometry>
    <!-- <geometry>
      <mesh filename="package://rebob_sim_description/meshes/velodyne.stl" scale="0.001 0.001 0.001"/>
    </geometry> -->
  </collision>
</link>

<joint name="wheel_rr_joint" type="continuous">
  <origin xyz="-0.20582 -0.440018 0.072471" rpy="0 0 -1.57"/>
  <parent link="base_link"/>
  <child link="wheel_rr"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="wheel_fr_joint" type="continuous">
  <origin xyz="0.209915 -0.440018 0.072471" rpy="0 0 -1.57"/>
  <parent link="base_link"/>
  <child link="wheel_fr"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="wheel_rl_joint" type="continuous">
  <origin xyz="-0.20582 0.439276 0.072471" rpy="0 0 -1.57"/>
  <parent link="base_link"/>
  <child link="wheel_rl"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="wheel_fl_joint" type="continuous">
  <origin xyz="0.209915 0.439276 0.072471" rpy="0 0 -1.57"/>
  <parent link="base_link"/>
  <child link="wheel_fl"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>
