<link name="velodyne">
  <inertial>
    <origin xyz="4.163336342344337e-17 4.999999999588667e-07 0.042556105337969774" rpy="0 0 0"/>
    <mass value="3.734417588986906"/>
    <inertia ixx="0.003845" iyy="0.003845" izz="0.003365" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
