  <collision>
    <origin xyz="-0.06 0 0" rpy="0 1.57 0"/>
    <geometry>
      <!-- <mesh filename="file://$(find rebob_sim_description)/meshes/wheel_fr.stl" scale="0.001 0.001 0.001"/> -->
      <cylinder length="0.12" radius="0.163"/>
    </geometry>
  </collision>
</link>

<link name="wheel_rl">
