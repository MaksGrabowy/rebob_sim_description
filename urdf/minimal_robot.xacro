    </geometry>
  </collision>
</link>

<link name="wheel_fl">
  <!-- <pose relative_to="base_link">-0.20582 0.439276 0.072471 0 0 -1.57</pose> -->
  <inertial>
    <origin xyz="-0.0689999999999999 4.999999975996428e-07 9.71445146547012e-17" rpy="0 0 1.57"/>
    <mass value="88.47305525364588"/>
    <inertia ixx="1.158616" iyy="0.714609" izz="0.714609" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
